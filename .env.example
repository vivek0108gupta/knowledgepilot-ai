# Copy to `.env` and adjust. `.env` is gitignored; never commit real values.
# Everything here is optional for local development: docker-compose.yml has matching defaults.

# --- Postgres (local Docker only) ---
POSTGRES_USER=knowledgepilot
POSTGRES_PASSWORD=change-me
POSTGRES_DB=knowledgepilot
POSTGRES_HOST_PORT=5434

# --- API ---
ENVIRONMENT=development
# DEBUG, INFO, WARNING, or ERROR.
LOG_LEVEL=INFO
API_HOST_PORT=8000
# Comma-separated browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:3000
# Used when running the API outside Docker (inside Docker, compose builds this from the values above).
DATABASE_URL=postgresql+asyncpg://knowledgepilot:change-me@localhost:5434/knowledgepilot

# --- Web ---
WEB_HOST_PORT=3000
# Inlined into the browser bundle at build time. Public by design; never put secrets in NEXT_PUBLIC_*.
NEXT_PUBLIC_API_URL=http://localhost:8000

# --- Added in later milestones (placeholders, not read yet) ---

# Copy to `.env` and adjust. `.env` is gitignored; never commit real values.
# Everything here is optional for local development: docker-compose.yml has matching defaults.

# --- Postgres (local Docker only) ---
POSTGRES_USER=knowledgepilot
POSTGRES_PASSWORD=change-me
POSTGRES_DB=knowledgepilot
POSTGRES_HOST_PORT=5434

# --- API ---
ENVIRONMENT=development
# DEBUG, INFO, WARNING, or ERROR.
LOG_LEVEL=INFO
API_HOST_PORT=8000
# Comma-separated browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:3000
# Used when running the API outside Docker (inside Docker, compose builds this from the values above).
DATABASE_URL=postgresql+asyncpg://knowledgepilot:change-me@localhost:5434/knowledgepilot

# --- Web ---
WEB_HOST_PORT=3000
# Inlined into the browser bundle at build time. Public by design; never put secrets in NEXT_PUBLIC_*.
NEXT_PUBLIC_API_URL=http://localhost:8000

# --- Supabase Auth: web ---
# Project URL and publishable key, from the Supabase dashboard (Project Settings > API Keys).
# Both are public by design and are compiled into the browser bundle.
# Never put the secret or service-role key in a NEXT_PUBLIC_* variable, or anywhere in the web app.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# --- Supabase Auth: API ---
# The API verifies access tokens against the project's public signing keys (JWKS).
# It needs no Supabase key at all. Only SUPABASE_URL is required; the other two are derived
# from it when left empty:
#   SUPABASE_ISSUER   = <SUPABASE_URL>/auth/v1
#   SUPABASE_JWKS_URL = <SUPABASE_URL>/auth/v1/.well-known/jwks.json
SUPABASE_URL=
SUPABASE_JWKS_URL=
SUPABASE_ISSUER=

# --- Supabase Storage: API only ---
# A server-side key: a secret key (sb_secret_...) or the legacy service_role key, from
# Project Settings > API Keys. It bypasses storage access rules, so:
#   - set it only here, for the API; the web app must never receive it
#   - never give it a NEXT_PUBLIC_ name
#   - never commit it or paste it into chat, tickets or logs
SUPABASE_SECRET_KEY=
# The private bucket that holds uploaded files. See "Storage setup" in the README.
SUPABASE_STORAGE_BUCKET=knowledgepilot-documents
# How long a download link works, in seconds.
SIGNED_URL_TTL_SECONDS=60

# --- OpenAI embeddings: API only ---
# Used to turn document text and search queries into vectors. Server-side only, like the
# storage key: never give it a NEXT_PUBLIC_ name, never commit it, never paste it into chat.
# Without it, uploads end as "failed" (they cannot be indexed) and search returns a clear
# "not configured" error. Nothing is ever marked ready without its embeddings.
OPENAI_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
# The model that answers questions, through OpenAI's Responses API. Uses OPENAI_API_KEY.
OPENAI_CHAT_MODEL=gpt-4.1-mini
# Answering. Passages retrieved per question (default 5, at most CHAT_MAX_TOP_K) and the
# similarity a passage needs to be used (0 to 1; an estimate, tune it on real questions).
CHAT_TOP_K=5
CHAT_MAX_TOP_K=10
CHAT_MIN_SIMILARITY=0.2
# Token budgets for what the model is shown: passages, and earlier turns of the conversation.
CHAT_CONTEXT_TOKENS=6000
CHAT_MAX_CHUNKS_PER_DOCUMENT=3
CHAT_HISTORY_MESSAGES=10
CHAT_HISTORY_TOKENS=2000
# The answer itself, and how hard to try when OpenAI is slow or busy.
CHAT_TEMPERATURE=0.2
CHAT_MAX_OUTPUT_TOKENS=1000
CHAT_TIMEOUT_SECONDS=45
CHAT_MAX_ATTEMPTS=3
# The most a streamed answer may take from request to last word (below the 300 s lease).
CHAT_STREAM_TIMEOUT_SECONDS=120

# --- Security and cost controls (docs/security-cost-controls-operations.md) ---------------
# Local-development defaults. Every limit is enforced by the API, in PostgreSQL.
RATE_LIMITS_ENABLED=true
# Requests per sliding window. /chat and /chat/stream share the chat limits.
RATE_LIMIT_CHAT_PER_MINUTE=10
RATE_LIMIT_CHAT_PER_WORKSPACE_PER_MINUTE=60
RATE_LIMIT_SEARCH_PER_MINUTE=30
RATE_LIMIT_UPLOAD_PER_HOUR=10
# Running at once: answers per user, AI operations per workspace, documents waiting for
# or undergoing ingestion per workspace.
MAX_CONCURRENT_GENERATIONS_PER_USER=3
MAX_CONCURRENT_AI_OPERATIONS_PER_WORKSPACE=10
MAX_INGESTION_JOBS_PER_WORKSPACE=5
# Quotas (tokens are input + output of every AI operation; days and months are UTC).
USER_DAILY_TOKEN_LIMIT=500000
USER_DAILY_CHAT_LIMIT=200
WORKSPACE_MONTHLY_TOKEN_LIMIT=5000000
# In the pricing currency, against estimated cost (not an invoice).
WORKSPACE_MONTHLY_COST_LIMIT=10.00
# The most input one answer may send, as estimated before the call.
CHAT_MAX_INPUT_TOKENS=12000
# A reservation never finalised (for example after a crash) is treated as abandoned after
# this long. Must exceed CHAT_GENERATION_LEASE_SECONDS (300).
USAGE_RESERVATION_TTL_SECONDS=600
INGESTION_RESERVATION_TTL_SECONDS=3600
# Optional: replace the default price table (app/core/config.py, DEFAULT_PRICING). Change
# the version whenever prices change. Example:
# USAGE_PRICING_JSON={"version":"openai-2026-11","currency":"USD","models":{"gpt-4.1-mini":{"input_per_million":"0.40","output_per_million":"1.60"},"text-embedding-3-small":{"input_per_million":"0.02","output_per_million":"0"}}}
USAGE_PRICING_JSON=
# Fixed by the database column (vector(1536)). Changing it needs a migration.
EMBEDDING_DIMENSIONS=1536
# Chunking, in tokens of the embedding model.
CHUNK_SIZE_TOKENS=800
CHUNK_OVERLAP_TOKENS=100
# Search: the most results one request may ask for, and the similarity below which a
# passage is left out (0 to 1; 0 turns the cut-off off).
SEARCH_MAX_TOP_K=20
SEARCH_MIN_SIMILARITY=0.2

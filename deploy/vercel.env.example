# Vercel project (Root Directory: apps/web) → Settings → Environment Variables → Production.
# These are compiled into the browser bundle: PUBLIC values only. The build refuses to run on
# Vercel if NEXT_PUBLIC_API_URL is missing, not https://, or localhost.

# The Render service URL, no trailing slash.
NEXT_PUBLIC_API_URL=https://<your-service>.onrender.com

# Supabase → Project Settings → API Keys: the project URL and the PUBLISHABLE (anon) key.
# Never the secret / service-role key.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=<publishable-key>
